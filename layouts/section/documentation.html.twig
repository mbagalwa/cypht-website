{% extends 'page.html.twig' %}

{% block content_area %}
	<div class="doc-container">
		<div class="row p-2">
			{% include 'partials/doc_menu.html.twig' %}
			<div class="col">
				<div class="row doc-content">
					{# A page can borrow the body of another one (`redirect`), so the
					   content and its format are resolved before rendering. #}
					{% set content_page = (page.redirect is defined and site.pages[page.redirect]) ? site.pages[page.redirect] : page %}
					{% if content_page.format|default('html') == 'md' %}
						{# Pure Markdown page: the chrome is generated, not written by hand #}
						{% include 'partials/doc_markdown.html.twig' with {'page': content_page} %}
					{% else %}
						{{ content_page.content }}
					{% endif %}
				</div>
			</div>
		</div>
	</div>
{% endblock %}
